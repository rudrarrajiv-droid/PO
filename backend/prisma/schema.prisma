generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   // Admin, Planning, Production, Dispatch, Management
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  auditLogs AuditLog[]
  jobCards  JobCard[]
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  products  Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  artworkNo   String   @unique
  itemName    String
  customerId  Int
  length      Float
  width       Float
  height      Float
  color       String?
  ply         Int
  flute       String?
  reelSize    Float
  cutSize     Float
  pinQty      Int      @default(0)
  pinPasting  String?
  ups         Float    @default(1)
  creasing    String?
  packing     String?
  specialReq  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer       @relation(fields: [customerId], references: [id])
  layers      ProductLayer[]
  jobCards    JobCard[]
}

model ProductLayer {
  id         Int     @id @default(autoincrement())
  productId  Int
  layerName  String  // Top, Flute 1, Liner 2, etc.
  paperType  String?
  bf         String?
  gsm        Float?

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model JobCard {
  id             Int      @id @default(autoincrement())
  jobCardNo      String   @unique
  targetDate     DateTime
  productId      Int
  orderQty       Int
  oneBoxWeight   Float
  totalWeight    Float
  priority       String   @default("Normal")
  status         String   @default("Pending") // Pending, Issued, Completed, Cancelled
  remarks        String?
  createdById    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product             @relation(fields: [productId], references: [id])
  createdBy      User                @relation(fields: [createdById], references: [id])
  production     ProductionTracking[]
}

model ProductionTracking {
  id             Int      @id @default(autoincrement())
  jobCardId      Int
  department     String   // Corrugation Deptt, Paper Cutting, Pasting, Rotary, RS4, Finish Goods
  productionQty  Int
  operatorName   String?
  supervisorSign String?
  recordedAt     DateTime @default(now())

  jobCard        JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
}

model ReelInventory {
  id             Int      @id @default(autoincrement())
  reelNo         String   @unique
  paperType      String
  size           Float
  bf             String
  gsm            Float
  weightIn       Float    @default(0)
  weightOut      Float    @default(0)
  currentBalance Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  transactions   ReelTransaction[]
}

model ReelTransaction {
  id             Int      @id @default(autoincrement())
  reelId         Int
  type           String   // IN, OUT
  weight         Float
  date           DateTime
  remarks        String?

  reel           ReelInventory @relation(fields: [reelId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  entityId  Int
  userId    Int
  timestamp DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
}
